{
  "name": "pose-mentor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "predev": "node scripts/setup-assets.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/setup-assets.mjs && node scripts/build-voices.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "data:fetch": "python3 scripts/fetch_uiprmd.py",
    "data:calibrate": "node scripts/calibrate.ts",
    "data:evaluate": "node scripts/evaluate.ts",
    "data:fetch-rehabpile": "python3 scripts/fetch_rehabpile.py",
    "data:calibrate-rehabpile": "node scripts/calibrate-rehabpile.ts",
    "voices": "node scripts/build-voices.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@huggingface/transformers": "3.8.1",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "kokoro-js": "1.2.1",
    "onnxruntime-node": "1.21.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wasm-media-encoders": "0.7.0"
  }
}
